@startuml
skinparam classAttributeIconSize 0
hide empty methods
left to right direction

class User {
  +id: UUID
  +email: String
  +role: Role
}
class Product {
  +id: UUID
  +name: String
  +active: Boolean
}
class ProductVariant {
  +id: UUID
  +size: String
  +priceVnd: Long
}
class Order {
  +id: UUID
  +status: OrderStatus
  +totalVnd: Long
  +version: Int
}
class OrderItem {
  +id: UUID
  +qty: Int
  +unitPriceSnapshotVnd: Long
  +optionsSnapshot: JSON
}
class Payment {
  +id: UUID
  +status: PaymentStatus
  +provider: PaymentProviderType
}
class PaymentAttempt {
  +id: UUID
  +idempotencyKey: String
  +requestHash: String
  +providerTxnRef: String
}
class Refund {
  +id: UUID
  +orderId: UUID
  +status: RefundStatus
  +amountVnd: Long
  +bankCode: String
  +accountNumber: String
  +accountName: String
  +confirmedBy: UUID?
  +evidenceRef: String?
}
class RefundAttempt {
  +id: UUID
  +refundId: UUID
  +baristaId: UUID
  +attemptNo: Int
  +status: RefundStatus
  +failureReason: String?
  +startedAt: DateTime
  +finishedAt: DateTime?
}
class Promotion {
  +id: UUID
  +code: String
  +quota: Int
}
class PromotionRedemption {
  +id: UUID
  +status: ReservationStatus
}
class LoyaltyTransaction {
  +id: UUID
  +type: LoyaltyType
  +points: Decimal
  +amountVndEquivalent: Long
}
class InventoryReservation {
  +id: UUID
  +status: ReservationStatus
  +releasedAt: DateTime?
}
interface PaymentProvider {
  +createPaymentIntent(...)
  +verifyNotification(...)
  +queryPayment(...)
}
class VNPaySandboxAdapter
class MockPaymentAdapter

PaymentProvider <|.. VNPaySandboxAdapter
PaymentProvider <|.. MockPaymentAdapter

User "1" -- "0..*" Order : places
User "1" -- "0..*" LoyaltyTransaction : has
Product "1" -- "0..*" ProductVariant
Order "1" *-- "1..*" OrderItem
ProductVariant "1" -- "0..*" OrderItem : snapshot source
Order "1" -- "0..*" Payment
Payment "1" *-- "1..*" PaymentAttempt
Order "1" -- "0..1" Refund : triggers on cancel
Refund "1" *-- "0..*" RefundAttempt : logs
Order "1" -- "0..*" InventoryReservation
Promotion "1" -- "0..*" PromotionRedemption
Order "1" -- "0..*" PromotionRedemption
Order "1" -- "0..*" LoyaltyTransaction
Payment ..> PaymentProvider : calls for collection

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}
enum RefundStatus {
  PENDING
  IN_PROGRESS
  FAILED
  UNKNOWN
  COMPLETED
}
enum LoyaltyType {
  EARNED
  REDEEMED
  REVERSED
}
enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED
}
enum Role {
  CUSTOMER
  BARISTA
  MANAGER
}
enum PaymentProviderType {
  VNPAY
  MOCK
}

Order ..> OrderStatus
Payment ..> PaymentStatus
Refund ..> RefundStatus
RefundAttempt ..> RefundStatus
LoyaltyTransaction ..> LoyaltyType
InventoryReservation ..> ReservationStatus
User ..> Role
Payment ..> PaymentProviderType
@enduml
