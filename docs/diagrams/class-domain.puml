@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty methods

class User {
  id : Int
  email : String
  role : Role
  loyaltyPoints : Int
}

class Order {
  id : Int
  userId : Int
  status : OrderStatus
  total : Int
  pointsEarned : Int
}

class LoyaltyTransaction {
  id : Int
  userId : Int
  orderId : Int
  points : Int
}

class OrderItem {
  id : Int
  orderId : Int
  productId : Int
  quantity : Int
  lineTotal : Int
}

class Payment {
  id : Int
  status : PaymentStatus
  amount : Int
  refundRef : String?
  refundedAt : DateTime?
}

class Promotion {
  code / id
  value
  expiresAt
}

class Product {
  id : Int
  name : String
  price : Int
  stock : Int
}

class Ingredient {
  id : Int
  name : String
  quantity : Decimal
  version : Int
}

User "1" -- "N" Order
User "1" -- "N" LoyaltyTransaction
Order "1" -- "N" OrderItem
Order "1" -- "N" Payment
Order "N" .. "0..1" Promotion
OrderItem "N" -- "1" Product
Product .. Ingredient : recipe / inventory
@enduml
