@startuml
left to right direction
skinparam shadowing false
actor "Customer" as C
actor "Barista" as B
actor "VNPay Sandbox" as V
rectangle "UC-CHK-01 Checkout & Cancellation" {
 usecase "Chọn món/giỏ" as CART
 usecase "Đăng nhập" as AUTH
 usecase "UC-05 Tạo đơn" as ORDER
 usecase "Kiểm tra giá/kho" as VALIDATE
 usecase "UC-07 Chọn provider & khởi tạo" as PAY
 usecase "UC-08 Xác thực IPN / QueryDr" as IPN
 usecase "UC-12 Theo dõi" as TRACK
 usecase "UC-09 Hủy unpaid" as CANCEL1
 usecase "UC-10 Hủy PAID" as CANCEL2
 usecase "Tạo VietQR & xác nhận hoàn tiền" as REFUND_QR
 usecase "UC-13 Pha chế" as PREP
}
C --> CART
C --> ORDER
C --> PAY
C --> TRACK
C --> CANCEL1
C --> CANCEL2
B --> REFUND_QR
B --> PREP
V --> IPN
ORDER ..> AUTH : <<include>>
ORDER ..> VALIDATE : <<include>>
PAY ..> IPN : <<triggers asynchronously>>
CANCEL2 ..> REFUND_QR : <<triggers pending refund>>
PREP ..> IPN : <<requires PAID>>
@enduml
