digraph G {
 graph [label="activity-checkout — BrewLite A2 design", labelloc="t",fontsize=19, fontname="DejaVu Sans", bgcolor="white",pad="0.5",rankdir="TB",nodesep="0.4",ranksep="0.75",splines="spline"];
 node [style="rounded,filled",fontname="DejaVu Sans",fontsize=11,margin="0.20,0.13",penwidth=1.3,color="#64748b"];
 edge [color="#475569",fontname="DejaVu Sans",fontsize=10,arrowsize=0.7];
 "a" [label="Start: menu / size / topping", shape=box, fillcolor="#eff6ff"];
"b" [label="Cart + login check", shape=diamond, fillcolor="#fff7ed"];
"login" [label="JWT login / register", shape=box, fillcolor="#eff6ff"];
"c" [label="POST /orders: verify JWT + price", shape=box, fillcolor="#eff6ff"];
"stock" [label="Stock and promo available?", shape=diamond, fillcolor="#fff7ed"];
"err" [label="409/422 → edit cart → End", shape=box, fillcolor="#eff6ff"];
"order" [label="TX create PENDING + reserve inventory", shape=box, fillcolor="#eff6ff"];
"pay" [label="POST payment intent + idempotency", shape=box, fillcolor="#eff6ff"];
"vnp" [label="VNPay Sandbox redirect & signed IPN", shape=box, fillcolor="#fff7ed"];
"valid" [label="Signature, amount, txnRef valid?", shape=diamond, fillcolor="#fff7ed"];
"bad" [label="Reject/record error, QueryDr if UNKNOWN", shape=box, fillcolor="#eff6ff"];
"res" [label="Payment success?", shape=diamond, fillcolor="#fff7ed"];
"failed" [label="PAYMENT_FAILED; retry with fresh key", shape=box, fillcolor="#eff6ff"];
"paid" [label="PAID; UI GET Order state", shape=box, fillcolor="#eff6ff"];
"cancel" [label="Customer requests cancellation?", shape=diamond, fillcolor="#fff7ed"];
"can" [label="Allowed state PENDING/FAILED/PAID?", shape=diamond, fillcolor="#fff7ed"];
"nop" [label="409 (PREPARING+) → End", shape=box, fillcolor="#eff6ff"];
"unpaid" [label="Unpaid: CANCELLED + release once", shape=box, fillcolor="#eff6ff"];
"ref" [label="PAID: refund through Provider", shape=box, fillcolor="#eff6ff"];
"refres" [label="Refund result?", shape=diamond, fillcolor="#fff7ed"];
"ok" [label="SUCCESS: CANCELLED, no points", shape=box, fillcolor="#eff6ff"];
"fail" [label="confirmed FAILED: CANCELLED + credit once", shape=box, fillcolor="#eff6ff"];
"unknown" [label="UNKNOWN: reconcile, no points", shape=box, fillcolor="#eff6ff"];
"barista" [label="Barista: PREPARING → READY → COMPLETED", shape=box, fillcolor="#eff6ff"];
"end" [label="Customer tracks order; End", shape=box, fillcolor="#eff6ff"];
"a" -> "b" [label=""];
"b" -> "login" [label="No JWT"];
"login" -> "c" [label="JWT"];
"b" -> "c" [label="JWT valid"];
"c" -> "stock" [label=""];
"stock" -> "err" [label="No"];
"stock" -> "order" [label="Yes"];
"order" -> "pay" [label=""];
"pay" -> "vnp" [label=""];
"vnp" -> "valid" [label="IPN"];
"valid" -> "bad" [label="Invalid/Unknown"];
"bad" -> "res" [label="if verified QueryDr"];
"valid" -> "res" [label="Valid"];
"res" -> "failed" [label="Failed"];
"res" -> "paid" [label="Success"];
"paid" -> "cancel" [label=""];
"cancel" -> "barista" [label="No"];
"cancel" -> "can" [label="Yes"];
"can" -> "nop" [label="No"];
"can" -> "unpaid" [label="PENDING/FAILED"];
"can" -> "ref" [label="PAID"];
"ref" -> "refres" [label=""];
"refres" -> "ok" [label="SUCCESS"];
"refres" -> "fail" [label="confirmed FAILED"];
"refres" -> "unknown" [label="UNKNOWN"];
"unknown" -> "end" [label="pending"];
"ok" -> "end" [label=""];
"fail" -> "end" [label=""];
"unpaid" -> "end" [label=""];
"barista" -> "end" [label=""];

 }
