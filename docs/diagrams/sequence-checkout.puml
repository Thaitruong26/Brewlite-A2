@startuml
hide footbox
autonumber
actor Customer as C
participant "Next.js UI" as Web
participant "NestJS API" as API
database "PostgreSQL" as DB
participant "Payment Service\n(PaymentProvider)" as Pay
participant "VNPay Sandbox" as VN
C -> Web : Menu → cart → checkout
Web -> API : POST /orders (JWT, items, promotion)
API -> API : Verify JWT / validate DTO / server pricing
API -> DB : BEGIN; lock/reserve stock + promo
alt Out of stock / invalid
  DB --> API : Error
  API -> DB : ROLLBACK
  API --> Web : 409/422
  Web --> C : Sửa giỏ
else Valid
  API -> DB : INSERT Order PENDING + OrderItem snapshot
  API -> DB : COMMIT
  API --> Web : 201 orderId, totalVnd
  C -> Web : Chọn VNPay
  Web -> API : POST /orders/{id}/payments (Idempotency-Key)
  API -> API : Verify JWT/ownership/order status
  API -> DB : Lookup unique key + request hash
  alt Same key and body replay
    DB --> API : Original result
    API --> Web : Original payment URL/status
  else New attempt
    API -> Pay : createPaymentIntent(order, amount)
    Pay --> API : URL + providerTxnRef
    API -> DB : Store PaymentAttempt PENDING
    API --> Web : Signed URL
    Web --> C : HTTP redirect URL
    C -> VN : Browser opens signed payment page
    VN -> API : IPN(vnp_TxnRef, vnp_Amount, status, signature)
    API -> Pay : verifyNotification(payload)
    Pay --> API : Verified data / invalid
    API -> DB : Check txnRef, amount, status, idempotent lock
    alt Verified SUCCESS
      API -> DB : Payment SUCCESS; Order PAID (transaction)
      API --> VN : IPN success response
    else Verified FAILED
      API -> DB : Payment FAILED; Order PAYMENT_FAILED
      API --> VN : IPN acknowledged
    else Invalid or UNKNOWN
      API -> DB : Do not mark PAID; store audit/UNKNOWN
      API -> Pay : queryPayment() when needed
      Pay -> VN : QueryDr request
      VN --> Pay : QueryDr result
      Pay --> API : Verified result
    end
  end
  VN --> C : Browser redirect to ReturnUrl (display only)
  C -> Web : View status
  Web -> API : GET /orders/{id}
  API -> DB : Read authoritative Order state
  DB --> API : Order/Payment state
  API --> Web : PENDING / FAILED / PAID / UNKNOWN
  Web --> C : Display authoritative status
end
@enduml
