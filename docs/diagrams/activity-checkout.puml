@startuml
skinparam shadowing false
|Customer|
start
:Xem menu, chọn size/topping;
|Next.js UI|
:Quản lý giỏ hàng, xác thực JWT;
|NestJS API + DB|
:Tính giá từ DB, kiểm tra kho;
:Tạo Order PENDING (giữ nguyên liệu trong transaction);
if (Đủ hàng?) then (Không)
  :Rollback / trả 409 OUT_OF_STOCK;
  |Next.js UI|
  :Hiển thị lỗi, sửa giỏ;
  stop
else (Có)
  |Customer|
  :Chọn VNPay Sandbox / Mock test;
  |NestJS API + DB|
  :Tạo URL thanh toán + Idempotency-Key;
  |VNPay Sandbox|
  :Thanh toán & gửi IPN;
  |NestJS API + DB|
  :Xác minh chữ ký HMAC, amount, txnRef;
  repeat
    if (Xác minh thành công?) then (Không)
      :Order PAYMENT_FAILED / Payment FAILED;
      |Next.js UI|
      :Thử lại (Retry) hoặc hủy đơn;
    else (Có)
      :Order PAID + Payment SUCCESS;
      :Cộng điểm LoyaltyTransaction đúng một lần;
      |Barista|
      :Tiếp nhận & pha chế: PREPARING -> READY -> COMPLETED;
      stop
    endif
  repeat while (Khách thử thanh toán lại?) is (Retry)
  stop
endif
@enduml
