@startuml
skinparam shadowing false
|Customer|
start
:Xem menu, chọn size/topping;
:Giỏ hàng / xác nhận checkout;
|Next.js UI|
if (Có JWT hợp lệ?) then (Có)
else (Không)
  |Customer|
  :Đăng nhập / đăng ký;
  |NestJS API|
  :Xác minh credential, phát JWT;
endif
|Next.js UI|
:Gửi POST /orders;
|NestJS API + DB|
:Validate, tính giá từ DB;
if (Đủ kho và promo?) then (Có)
  :BEGIN transaction;
  :Tạo Order PENDING + snapshot;
  :Reserve stock và promo;
  :COMMIT;
else (Không)
  :Rollback / 409 conflict;
  |Next.js UI|
  :Báo hết hàng, sửa giỏ;
  stop
endif
|Customer|
:Chọn phương thức thanh toán thẻ (VNPay);
|Next.js UI|
:Gửi payment intent + idempotency key;
|NestJS API + DB|
:Tạo PaymentAttempt, ký URL;
|VNPay Sandbox|
:Thanh toán sandbox;
:Callback IPN;
|NestJS API + DB|
:Xác minh chữ ký HMAC, amount, txnRef;
if (IPN hợp lệ và thành công?) then (Có)
  :Payment SUCCESS, Order PAID;
else (Không)
  if (Không xác định / timeout?) then (Có)
    :Payment UNKNOWN, QueryDr;
    if (Đối soát success?) then (Có)
       :Payment SUCCESS, Order PAID;
    else (Không)
       :Payment FAILED / chờ thử lại;
       |Next.js UI|
       :Hiển thị thất bại / chờ kết quả;
       stop
    endif
  else (Thất bại)
    :Payment FAILED, Order PAYMENT_FAILED;
    |Next.js UI|
    :Hiển thị thử lại với key mới;
    stop
  endif
endif
|Next.js UI|
:GET order status từ backend;
|Customer|
:Xem trạng thái / có thể yêu cầu hủy;
if (Yêu cầu hủy?) then (Có)
  |Customer|
  :Nhập ngân hàng & STK thụ hưởng;
  |NestJS API + DB|
  if (Order PAID và chưa PREPARING?) then (Hợp lệ)
    :BEGIN transaction;
    :Order chuyển CANCELLED ngay;
    :Release kho, promo, điểm đã dùng;
    :Thu hồi điểm đã tích của đơn;
    :Tạo Refund PENDING;
    :COMMIT;
    |Barista|
    :Xem danh sách hoàn tiền PENDING trên KDS;
    :Nhận xử lý (claim Refund IN_PROGRESS);
    :Hệ thống sinh mã Napas247 VietQR;
    :Quét QR chuyển tiền thủ công qua Banking App;
    if (Chuyển khoản thành công?) then (Có)
      :Bấm xác nhận + lưu bằng chứng;
      |NestJS API + DB|
      :Refund COMPLETED + audit log;
    else (Không)
      if (Chưa rõ kết quả?) then (Có)
        |Barista|
        :Đánh dấu UNKNOWN;
        :Đối soát sao kê trước khi chuyển lại;
      else (Thất bại)
        |Barista|
        :Đánh dấu FAILED;
        :Cho phép thử lại có kiểm soát (RefundAttempt);
      endif
    endif
  else (Không)
    :Hủy PENDING/FAILED hoặc trả 409 nếu PREPARING+;
  endif
  stop
else (Không)
  |Barista|
  :PAID -> PREPARING -> READY -> COMPLETED;
  |NestJS API + DB|
  :Ghi điểm EARNED một lần;
  |Customer|
  :Theo dõi kết quả;
  stop
endif
@enduml
