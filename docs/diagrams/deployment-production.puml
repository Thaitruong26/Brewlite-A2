@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundCorner 8
skinparam linetype ortho
left to right direction

title DEP-01: Kiến Trúc Triển Khai Production Trên Nền Tảng Render Cloud (Render Cloud Platform Blueprint)

node "Khách hàng (Customer Device)" as Phone {
  artifact "Mobile Browser\n(Next.js Web PWA)" as MobileUI
}

node "Quầy Pha Chế (Barista Station)" as BaristaNode {
  artifact "KDS Browser\n(Tablet / PC Web)" as BaristaUI
  artifact "Mobile Banking App\n(Quét Napas247 VietQR)" as BankApp
}

frame "CI/CD: GitHub Platform" as GitHubCI {
  artifact "GitHub Actions CI\n(Lint, Test, Build, Scan)" as GHA_CI
  artifact "GitHub Actions CD\n(Docker Buildx SHA tag)" as GHA_CD
  cloud "GHCR.io Registry\n(Container Images)" as GHCR
}

cloud "Nền Tảng Hosting: Render Cloud Platform (Singapore Region)" as RenderPlatform {
  node "Render Managed Ingress / Edge" as Edge {
    artifact "Cloudflare Ingress\nAuto TLS 1.3 (:443)\nDDoS Mitigation" as TLS
  }

  frame "Render Private Network (Isolated VPC)" as PrivateNet {
    node "Frontend Web Service\n[brewlite-web-bggg.onrender.com :3001]" as WebService {
      artifact "Next.js 16.4.0 Container\n(Node.js 22, Docker)" as NextApp
    }

    node "Backend API Web Service\n[brewlite-a2-syoc.onrender.com :4001]" as ApiService {
      artifact "NestJS 12 Modular Monolith\n(Prisma 7.10.x)" as NestApp
      artifact "Healthcheck Endpoint\nGET /api/health" as HealthCheck
    }

    database "Managed PostgreSQL 16\n[dpg-*.singapore.render.com :5432]" as ManagedDB {
      artifact "Persistent SSD Volume\n(ACID & Concurrency Locks)" as DBStorage
    }

    artifact "Render Secret Store / Env Groups\n(JWT_SECRET, DATABASE_URL, VNPAY_*)" as RenderSecrets
  }
}

cloud "Cổng Thanh Toán: VNPay Sandbox" as VNPayCloud {
  artifact "VNPay Payment Gateway\n(:443 Pay Redirect & QueryDR)" as VNPayGateway
}

' External Network Flow (HTTPS :443)
MobileUI --> TLS : HTTPS :443\n(Đặt món, thanh toán, hủy đơn)
BaristaUI --> TLS : HTTPS :443\n(Quản lý hàng đợi KDS, nhận VietQR)

' Ingress routing to Web Services
TLS --> NextApp : Reverse Proxy (:3001)
TLS --> NestApp : Reverse Proxy (:4001)\n(Public API & Webhook IPN)

' Frontend to Backend API
NextApp --> NestApp : HTTPS /api\n(Server-to-Server & Client Requests)

' Backend to Database inside Private Network
NestApp --> DBStorage : Private TCP :5432\n(Internal VPC No Internet Expose)

' Environment Secrets Binding
RenderSecrets ..> NextApp : Runtime Env
RenderSecrets ..> NestApp : Runtime Env

' Payment & VietQR Flow
NestApp --> VNPayGateway : HTTPS :443\n(Khởi tạo giao dịch thanh toán)
VNPayGateway --> NestApp : Webhook IPN HTTPS :443\n(Ký số HMAC verifyReturnUrl)

' VietQR Manual Refund Flow
BaristaUI ..> BankApp : Hiển thị mã VietQR động\n(STK, Ngân hàng, Số tiền, Nội dung)
BankApp ..> MobileUI : Chuyển khoản hoàn tiền trực tiếp Napas247\n(Barista xác nhận lưu bằng chứng)

' CI/CD Pipeline Flow
GHA_CI --> GHA_CD : Trigger sau khi pass test & build
GHA_CD --> GHCR : Push Docker Images (:latest & :sha)
GHCR --> NextApp : Render Deploy Hook / GitHub source
GHCR --> NestApp : Render Deploy Hook / GitHub source

@enduml
