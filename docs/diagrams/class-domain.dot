"Refund" [label="Refund | id | amountVnd | status", shape=record, fillcolor="#f8fafc"];
"Cancel" [label="CancellationRequest | id | state", shape=record, fillcolor="#f8fafc"];
"Promo" [label="Promotion | id | code | quota", shape=record, fillcolor="#f8fafc"];
"Redeem" [label="PromotionRedemption | id | status", shape=record, fillcolor="#f8fafc"];
"Loyalty" [label="LoyaltyTransaction | id | type | points | originRefundId", shape=record, fillcolor="#f8fafc"];
"Inventory" [label="InventoryReservation | orderId | qty | status", shape=record, fillcolor="#f8fafc"];
"Provider" [label="«interface» PaymentProvider | pay | verify | refund | query", shape=record, fillcolor="#f8fafc"];
"VN" [label="VNPaySandboxAdapter", shape=record, fillcolor="#f8fafc"];
"Mock" [label="MockPaymentAdapter", shape=record, fillcolor="#f8fafc"];
"Enum" [label="Enums: OrderStatus / PaymentStatus / RefundStatus / LoyaltyType", shape=record, fillcolor="#f8fafc"];
"User" -> "Order" [label="1 to 0..*"];
