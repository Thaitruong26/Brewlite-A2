digraph G {
 graph [label="class-domain — BrewLite A2 design", labelloc="t",fontsize=19, fontname="DejaVu Sans", bgcolor="white",pad="0.5",rankdir="LR",nodesep="0.4",ranksep="0.75",splines="spline"];
 node [style="rounded,filled",fontname="DejaVu Sans",fontsize=11,margin="0.20,0.13",penwidth=1.3,color="#64748b"];
 edge [color="#475569",fontname="DejaVu Sans",fontsize=10,arrowsize=0.7];
 "User" [label="User | id: UUID | email | role", shape=record, fillcolor="#f8fafc"];
"Product" [label="Product | id | active | name", shape=record, fillcolor="#f8fafc"];
"Variant" [label="ProductVariant | id | priceVnd", shape=record, fillcolor="#f8fafc"];
