  usecase "UC-03 Giỏ hàng" as uc03
  usecase "UC-05 Tạo đơn" as uc05
  usecase "UC-07 Khởi tạo VNPay/Mock" as uc07
  usecase "UC-08 Xác thực IPN" as uc08
  usecase "UC-09 Hủy chưa trả tiền" as uc09
  usecase "UC-10 Hủy PAID/refund/bù điểm" as uc10
  usecase "UC-12 Theo dõi đơn" as uc12
  usecase "UC-13 Pha chế" as uc13
  usecase "UC-14 Tích điểm" as uc14
