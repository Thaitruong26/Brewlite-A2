@startdot
digraph G {
  rankdir=LR;
  bgcolor="transparent";
  node [fontname="Arial", fontsize=11, color="#183d2c", fontcolor="#183d2c"];
  edge [color="#3b4d42", fontsize=10];

  subgraph cluster_customer {
    label="Khách hàng · Customer";
    color="#b8c7bc";
    style=rounded;
    fontname="Arial";
    fontsize=12;
    c_menu [label="Xem menu / tùy chọn", shape=ellipse];
    c_cart [label="Giỏ hàng & tính giá", shape=ellipse];
    c_login [label="Đăng nhập JWT", shape=ellipse];
    c_order [label="Tạo đơn & thanh toán", shape=ellipse];
    c_track [label="Theo dõi / lịch sử", shape=ellipse];
    c_cancel [label="Hủy đơn hợp lệ", shape=ellipse];
    c_menu -> c_cart;
    c_cart -> c_order;
    c_login -> c_order;
    c_order -> c_track;
    c_track -> c_cancel;
  }

  subgraph cluster_barista {
    label="Barista";
    color="#b8c7bc";
    style=rounded;
    fontname="Arial";
    fontsize=12;
    b_refund [label="Hoàn tiền VietQR", shape=ellipse];
    b_prep [label="Tiếp nhận & pha chế", shape=ellipse];
  }

  subgraph cluster_external {
    label="Bên ngoài";
    color="#b8c7bc";
    style=rounded;
    fontname="Arial";
    fontsize=12;
    ext_bank [label="Ứng dụng ngân hàng", shape=box];
    ext_vnpay [label="VNPay Sandbox", shape=box];
  }

  c_cancel -> b_refund;
  b_refund -> ext_bank;
  c_order -> b_prep;
  c_order -> ext_vnpay;
}
@enddot
